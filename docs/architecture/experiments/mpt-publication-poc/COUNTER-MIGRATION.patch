+    def test_proposed_report3_counter_matrix(self):
+        # Authored contract cases, not measured results or real approval.
+        raw, binding, approval = self.simulated_review(copy.deepcopy(self.generated))
+        original = copy.deepcopy(self.generated["records"])
+        mismatch = copy.deepcopy(original)
+        mismatch[0].update(hex="00", length=1, sha256=emitter.digest(b"\x00"))
+        invalid = copy.deepcopy(original)
+        invalid[0]["error"] = "SIMULATED-ERROR"
+        extra = copy.deepcopy(original[0])
+        extra["id"] = "EXTRA-NOT-REQUIRED"
+        bad_extra = copy.deepcopy(extra)
+        bad_extra["error"] = "SIMULATED-ERROR"
+        cases = [
+            ("empty", [], (428, 0, 0, 428, 0, 0, 0)),
+            ("all", original, (428, 428, 428, 0, 0, 0, 428)),
+            ("mismatch", mismatch, (428, 428, 427, 0, 0, 0, 428)),
+            ("invalid", invalid, (428, 428, 427, 0, 0, 1, 427)),
+            ("missing", original[:-1], (428, 427, 427, 1, 0, 0, 427)),
+            ("duplicate", original + [original[0]], (428, 429, 427, 0, 0, 2, 427)),
+            ("extra", original + [extra], (428, 429, 428, 0, 1, 0, 428)),
+            ("bad-extra", original + [bad_extra], (428, 429, 428, 0, 1, 1, 428)),
+            ("malformed", original + [None], (428, 429, 428, 0, 0, 1, 428)),
+            ("mixed", mismatch[:-1] + [mismatch[1], bad_extra],
+             (428, 429, 425, 1, 1, 3, 426)),
+        ]
+        names = ("required_slots", "observed_slots", "matched_slots", "missing_slots",
+                 "extra_slots", "invalid_slots", "compared_valid_slots")
+        for name, records, expected in cases:
+            with self.subTest(case=name):
+                result = self.compare(raw, binding=binding, approval=approval,
+                                      observe=lambda: copy.deepcopy(records))
+                self.assertEqual(result["report_spec"], "MPT-FROZEN-COMPARISON-REPORT@3")
+                self.assertNotIn("compared_slots", result)
+                self.assertEqual(tuple(result[k] for k in names), expected)
+                self.assertLessEqual(result["matched_slots"], result["compared_valid_slots"])
+                self.assertLessEqual(result["compared_valid_slots"],
